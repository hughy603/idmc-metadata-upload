{
  "name": "idmc-metadata-upload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "fresh-dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:unused": "eslint . --fix --rule 'no-unused-vars: off' --rule '@typescript-eslint/no-unused-vars: off'",
    "fix:unused-vars": "node scripts/fix-unused-vars.cjs",
    "fix:references": "node scripts/fix-reference-errors.cjs",
    "fix:undefined": "node scripts/fix-undefined-refs.cjs",
    "fix:imports": "node scripts/fix-common-imports.cjs",
    "fix:all": "node scripts/fix-all-linting.cjs",
    "fix:tests": "node scripts/fix-test-files.cjs",
    "fix:naming": "node scripts/fix-all-naming.js",
    "fix:return-types": "node scripts/fix-missing-return-types.cjs",
    "format": "prettier --write . --cache --cache-location .prettiercache",
    "format:check": "prettier --check . --cache --cache-location .prettiercache",
    "format:all": "prettier --write . --cache --cache-location .prettiercache",
    "typecheck": "tsc --noEmit",
    "fix-common-errors": "node scripts/fix-common-errors.js --fix-all",
    "test": "jest",
    "test:services": "jest lib/services --coverage=false",
    "test:utils": "jest utils --coverage=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky install",
    "axe-lint": "npx @axe-core/cli --stdout .",
    "spell-check": "npx typos",
    "duplicate-check": "jscpd .",
    "analyze": "ANALYZE=true npm run build",
    "analyze:win": "set ANALYZE=true && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/papaparse": "^5.3.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "next": "^15.2.1",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.50.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx-js-style": "^1.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.1",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/eslintrc": "^3.0.2",
    "@eslint/js": "^9.21.0",
    "@next/bundle-analyzer": "^15.2.1",
    "@next/eslint-plugin-next": "^15.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^29.7.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.1",
    "eslint-config-prettier": "^10.0.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jscpd": "^3.5.10",
    "lint-staged": "^15.2.2",
    "msw": "^2.2.1",
    "postcss": "^8.4.31",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=20 --cache",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
